  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25bb168cee2470f4d8cf05caae0f0d02, type: 3}
  m_Name: Prologue_PostMaster
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: "\uC6B0\uCCB4\uAD6D\uC7A5"
    text: "{\uC774\uB984}{\uC544/\uC57C}, \uC624\uB298 \uBC30\uB2EC \uC218\uACE0
      \uB9CE\uC558\uC5B4. \uC774\uC81C \uB531 \uD55C \uC7A5\uB9CC \uB0A8\uC558\uB2E8\uB2E4."
  - speaker: 
    text: "\uADF8\uB54C, \uAC70\uC13C \uB208\uBC14\uB78C\uC774 \uD718\uBAB0\uC544\uCCD0
      \uCEE4\uB2E4\uB780 \uCE74\uB4DC\uAC00 \uC870\uAC01\uC870\uAC01 \uD769\uC5B4\uC84C\uB2E4!"
  - speaker: "\uC6B0\uCCB4\uAD6D\uC7A5"
    text: "\uC790\uC815 \uC804\uC5D0 \uBC30\uB2EC\uD574\uC57C \uD558\uB294 \uCE74\uB4DC\uC778\uB370...!"
  - speaker: "{\uC774\uB984}"
    text: "\uC81C\uAC00 \uCC3E\uC544\uC62C\uAC8C\uC694. \uADFC\uB370 \uC774\uAC70,
      \uB204\uAD6C\uD55C\uD14C \uAC00\uB294 \uCE74\uB4DC\uC608\uC694?"
  - speaker: "\uC6B0\uCCB4\uAD6D\uC7A5"
    text: "\uADF8\uAC8C... \uBD09\uD22C \uC8FC\uC18C\uAC00 \uC816\uC5B4\uC11C \uBC88\uC838
      \uBC84\uB838\uC9C0 \uBB50\uC57C."
  - speaker: "\uC6B0\uCCB4\uAD6D\uC7A5"
    text: "\uC6B0\uC120 \uBC14\uB78C\uC5D0 \uD769\uC5B4\uC9C4 \uD3B8\uC9C0\uB4E4\uBD80\uD130
      \uBD84\uB958\uD568\uC5D0 \uB123\uC5B4 \uC8FC\uACA0\uB2C8? \uB2E4 \uC815\uB9AC\uB418\uBA74
      \uCE74\uB4DC \uC870\uAC01 \uD558\uB098\uB97C \uB9E1\uAE38\uAC8C."
