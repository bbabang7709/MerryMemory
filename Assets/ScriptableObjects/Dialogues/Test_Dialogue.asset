  m_Script: {fileID: 11500000, guid: 25bb168cee2470f4d8cf05caae0f0d02, type: 3}
  m_Name: Test_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: "\uC6B0\uCCB4\uAD6D\uC7A5"
    text: "\uC5B4\uC11C \uC640, \uC784\uC2DC \uC9D1\uBC30\uC6D0! \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC5C8\uB2E8\uB2E4."
  - speaker: "\uC6B0\uCCB4\uAD6D\uC7A5"
    text: "\uC624\uB298\uC740 \uD06C\uB9AC\uC2A4\uB9C8\uC2A4\uC774\uBE0C\uB77C\uC11C
      \uBC30\uB2EC\uD560 \uAC8C \uC544\uC8FC \uB9CE\uC544. \uAE00\uC790\uAC00 \uB2E4
      \uB098\uC624\uAE30 \uC804\uC5D0 \uD0A4\uB97C \uB204\uB974\uBA74 \uD55C \uBC88\uC5D0
      \uD45C\uC2DC\uB3FC."
  - speaker: 
    text: "(\uD654\uC790\uAC00 \uBE44\uC5B4 \uC788\uC73C\uBA74 \uC774\uB984\uD45C
      \uC5C6\uC774 \uD45C\uC2DC\uB41C\uB2E4.)"
