  m_Script: {fileID: 11500000, guid: 25bb168cee2470f4d8cf05caae0f0d02, type: 3}
  m_Name: Ending
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: 
    text: "\uD2B8\uB9AC \uC55E\uC5D0 \uC6B0\uD45C \uC870\uAC01\uC744 \uB300\uC5B4
      \uBCF4\uC790, \uC816\uC5B4 \uC788\uB358 \uBD09\uD22C\uC758 \uC8FC\uC18C\uAC00
      \uCC9C\uCC9C\uD788 \uB5A0\uC62C\uB790\uB2E4."
  - speaker: 
    text: "To. \uD654\uBA74 \uB108\uBA38\uC758 \uB108\uC5D0\uAC8C"
  - speaker: "{\uC774\uB984}"
    text: "...\uC544. \uADF8\uB798\uC11C \uB2E4\uB4E4 \uADF8\uB807\uAC8C \uB9D0\uD55C
      \uAC70\uAD6C\uB098."
  - speaker: "{\uC774\uB984}"
    text: "\uB0A0 \uC5EC\uAE30\uAE4C\uC9C0 \uB370\uB824\uC640 \uC900 \uAC70, \uB108\uC600\uAD6C\uB098."
  - speaker: "{\uC774\uB984}"
    text: "\uBC30\uB2EC \uC654\uC2B5\uB2C8\uB2E4! \uC6B0\uB9AC \uB9C8\uC744 \uBAA8\uB450\uAC00
      \uB108\uD55C\uD14C \uBCF4\uB0B4\uB294 \uCE74\uB4DC\uC57C."
  - speaker: "{\uC774\uB984}"
    text: "\uAC19\uC774 \uC640 \uC918\uC11C \uACE0\uB9C8\uC6CC. \uADF8\uB7FC, \uB2E4
      \uAC19\uC774..."
