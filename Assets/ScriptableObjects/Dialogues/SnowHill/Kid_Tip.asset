  lines:
  - speaker: "\uB208 \uC5B8\uB355 \uC544\uC774"
    text: "\uC5BC\uC74C \uC704\uC5D0\uC120 \uD55C \uBC88 \uBC00\uBA74 \uBB54\uAC00\uC5D0
