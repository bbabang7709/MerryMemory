  lines:
  - speaker: "\uCF67\uB178\uB798 \uC8FC\uBBFC"
    text: "\uD760~ \uD760\uD760~ \uBBF8 \uBBF8 \uBBF8~ \uBBF8 \uBBF8 \uBBF8~ \uBBF8
      \uC194 \uB3C4 \uB808 \uBBF8~"
  - speaker: "\uCF67\uB178\uB798 \uC8FC\uBBFC"
    text: "\uC544, \uB4E4\uC5C8\uC5B4? \uC2DC\uACC4\uD0D1 \uC885\uC9C0\uAE30\uAC00
      \uD574\uB9C8\uB2E4 \uCE58\uB294 \uCE90\uB7F4\uC774\uC57C."
  - speaker: "\uCF67\uB178\uB798 \uC8FC\uBBFC"
    text: "\uC5B4\uB9B4 \uB54C\uBD80\uD130 \uB4E4\uC5B4\uC11C \uC774\uC820 \uC790\uBA74\uC11C\uB3C4
      \uD765\uC5BC\uAC70\uB9B0\uB2E4\uB2C8\uAE4C."
