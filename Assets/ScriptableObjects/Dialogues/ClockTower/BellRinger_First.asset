  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25bb168cee2470f4d8cf05caae0f0d02, type: 3}
  m_Name: BellRinger_First
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: "\uC885\uC9C0\uAE30"
    text: "\uC5B4\uC11C \uC624\uAC8C. \uC885\uD0D1\uAE4C\uC9C0 \uCC3E\uC544\uC628
      \uC190\uB2D8\uC740 \uC624\uB79C\uB9CC\uC774\uAD70."
  - speaker: "\uC885\uC9C0\uAE30"
    text: "\uD574\uB9C8\uB2E4 \uD06C\uB9AC\uC2A4\uB9C8\uC2A4\uC774\uBE0C\uC5D4 \uC704\uCE35
      \uC885\uC73C\uB85C \uCE90\uB7F4\uC744 \uCCD0\uC11C, \uADF8 \uC18C\uB9AC\uB97C
      \uBA5C\uB85C\uB514 \uCE69\uC5D0 \uB2F4\uC544 \uB450\uC9C0."
  - speaker: "\uC885\uC9C0\uAE30"
    text: "\uADF8\uB7F0\uB370 \uC62C\uD574\uB294 \uC190\uC774 \uAD73\uC5C8\uB294\uC9C0
      \uC21C\uC11C\uAC00 \uC601 \uB5A0\uC624\uB974\uC9C8 \uC54A\uC544."
  - speaker: "\uC885\uC9C0\uAE30"
    text: "\uAD11\uC7A5 \uBCA4\uCE58\uC5D0 \uB298 \uCF67\uB178\uB798\uB97C \uD765\uC5BC\uAC70\uB9AC\uB294
      \uCE5C\uAD6C\uAC00 \uC788\uB294\uB370, \uADF8 \uCE5C\uAD6C\uB77C\uBA74 \uAE30\uC5B5\uD560\uC9C0\uB3C4
      \uBAA8\uB974\uACA0\uAD6C\uBA3C."
  - speaker: "\uC885\uC9C0\uAE30"
    text: "\uC885\uC740 \uB3C4, \uB808, \uBBF8, \uC194 \uB124 \uAC1C\uC57C. \uD2C0\uB824\uB3C4
      \uAD1C\uCC2E\uC73C\uB2C8 \uB9C8\uC74C\uAECF \uCCD0 \uBCF4\uAC8C."
