  lines:
  - speaker: "\uC6B0\uCCB4\uAD6D\uC7A5"
    text: "\uB2E4\uB4E4 \uBAA8\uC600\uAD6C\uB098! \uC790\uC815\uAE4C\uC9C0 \uC5BC\uB9C8
      \uC548 \uB0A8\uC558\uC5B4."
  - speaker: "\uC6B0\uCCB4\uAD6D\uC7A5"
    text: "{\uC774\uB984}{\uC544/\uC57C}, \uBAA8\uC544 \uC628 \uC870\uAC01\uC73C\uB85C
      \uCE74\uB4DC\uB97C \uC644\uC131\uD574 \uC8FC\uB834."
  - speaker: "\uB208 \uC5B8\uB355 \uC544\uC774"
    text: "\uBE68\uB9AC\uBE68\uB9AC! \uB204\uAD6C\uD55C\uD14C \uAC00\uB294 \uCE74\uB4DC\uC778\uC9C0
      \uAD81\uAE08\uD574!"
