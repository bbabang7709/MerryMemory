  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25bb168cee2470f4d8cf05caae0f0d02, type: 3}
  m_Name: Baker_First
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: "\uBE75\uC9D1 \uC0AC\uC7A5"
    text: "\uC5B4\uC11C \uC640\uC694! \uC6B0\uCCB4\uAD6D\uC5D0\uC11C \uC654\uAD6C\uB098.
      \uB9C8\uCE68 \uC798 \uC654\uC5B4."
  - speaker: "\uBE75\uC9D1 \uC0AC\uC7A5"
    text: "\uB9C8\uC744 \uCE74\uB4DC \uBD09\uD22C\uB97C \uB0B4\uAC00 \uB9E1\uC544
      \uB450\uACE0 \uC788\uC5C8\uAC70\uB4E0. \uC8FC\uC18C\uB294 \uC544\uC774\uB4E4\uC774
      \uAE00\uC790 \uC2A4\uD2F0\uCEE4\uB85C \uC608\uC058\uAC8C \uBD99\uC5EC \uC92C\uACE0."
  - speaker: "\uBE75\uC9D1 \uC0AC\uC7A5"
    text: "\uADF8\uB7F0\uB370 \uC624\uBE10 \uAE40\uC5D0 \uBA87 \uAE00\uC790\uB294
      \uBC88\uC838 \uBC84\uB9AC\uACE0, \uC2A4\uD2F0\uCEE4 \uC138 \uC7A5\uC740 \uBC14\uB78C\uC5D0
      \uB0A0\uC544\uAC00 \uBC84\uB838\uC9C0 \uBB50\uC57C."
  - speaker: "\uBE75\uC9D1 \uC0AC\uC7A5"
    text: "\uAD11\uC7A5 \uAC8C\uC2DC\uD310, \uAC1C\uC6B8 \uB098\uBB34 \uB2E4\uB9AC,
      \uB9C8\uC744 \uC785\uAD6C \uC544\uCE58 \uCABD\uC744 \uCC3E\uC544\uBCF4\uBA74
      \uC788\uC744 \uAC70\uC57C."
  - speaker: "\uBE75\uC9D1 \uC0AC\uC7A5"
    text: "\uC138 \uC7A5 \uB2E4 \uBAA8\uC544 \uC624\uBA74 \uC800\uAE30 \uC791\uC5C5\uB300\uC5D0\uC11C
      \uBD09\uD22C \uC8FC\uC18C\uB97C \uB9DE\uCDB0 \uBCF4\uC790\uACE0."
