  lines:
  - speaker: "\uBE75\uC9D1 \uC0AC\uC7A5"
    text: "\uC2A4\uD2F0\uCEE4\uB294 \uAD11\uC7A5 \uAC8C\uC2DC\uD310, \uAC1C\uC6B8
      \uB098\uBB34 \uB2E4\uB9AC, \uB9C8\uC744 \uC785\uAD6C \uC544\uCE58 \uCABD\uC5D0
      \uC788\uC744 \uAC70\uC57C."
  - speaker: "\uBE75\uC9D1 \uC0AC\uC7A5"
    text: "\uC8FC\uC18C\uB294 \uBCF4\uD1B5 '~\uC5D0\uAC8C'\uB85C \uB05D\uB098\uC796\uC544?
      \uADF8\uAC83\uBD80\uD130 \uB9DE\uCDB0 \uBD10."
